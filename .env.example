# Copy this file to .env for local testing.
# On Render, set these under Environment > Environment Variables instead.

# A string you invent yourself — enter the same value in Meta's
# API Setup > Configuration > Webhook screen.
VERIFY_TOKEN=choose_a_random_secret_string

# The permanent system-user access token from Meta Business Settings.
WHATSAPP_ACCESS_TOKEN=your_system_user_access_token

# Found in API Setup panel after connecting your WhatsApp Business account.
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id

# Optional — defaults to v23.0 if omitted.
GRAPH_API_VERSION=v23.0

# Render sets PORT automatically; only needed for local runs.
PORT=3000
